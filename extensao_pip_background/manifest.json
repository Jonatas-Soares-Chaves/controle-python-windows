{
  "manifest_version": 3,
  "name": "Controle Brilho - PiP Background",
  "version": "1.5.0",
  "minimum_chrome_version": "116",
  "action": {"default_popup": "popup.html", "default_title": "Controles da guia"},
  "description": "Brilho, volume individual, autoclicker e controle de picture-in-picture.",
  "permissions": [
    "scripting",
    "tabs",
    "storage",
    "activeTab",
    "tabCapture",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:17963/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js", "dim.js", "clicker-config.js", "clicker.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
